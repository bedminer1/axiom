[Unit]
Description=Hound inspection API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hound
Group=hound
WorkingDirectory=/opt/hound
ExecStart=/opt/hound/hound
Environment=HOUND_START_WEBSITE=0
Environment=HOUND_API_ADDRESS=127.0.0.1:5050
Environment=PFI_FILTER_DIR=/opt/hound/pfi-filter
Environment=PFI_FILTER_PYTHON=/opt/hound/.venv/bin/python
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SOCLAAS_ENV_FILE=%d/soclaas.env
LoadCredential=soclaas.env:/etc/hound-soclaas.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hound/pfi-filter/.pfi-cache

[Install]
WantedBy=multi-user.target
