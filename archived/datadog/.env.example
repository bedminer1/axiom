TELOXIDE_TOKEN=your_botfather_token
# Defaults are relative to telebot/, regardless of the launch directory.
YOLO_MODEL=models/crack.onnx
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.45
YOLO_ANNOTATIONS=false
# setup_model.py installs the native CPU runtime here.
ORT_DYLIB_PATH=models/libonnxruntime.dylib

# DeepSeek V4.1 Flash (text + vision), high reasoning.
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Hosted metadata database. Create a least-privilege database token in Turso.
TURSO_DATABASE_URL=libsql://datadog-bedminer1.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_database_token

# Public legal pages. Replace these before launch.
DATADOG_PRIVACY_URL=https://your-domain.example/privacy
DATADOG_TERMS_URL=https://your-domain.example/terms

# Source photos, thumbnails, annotations, reports, and the local SQLite fallback.
BOT_DATA_DIR=data
